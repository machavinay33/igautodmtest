# --- Database ---
# Production: paste the "External Database URL" from your Render Postgres
# instance here (Render dashboard > your database > Connections).
DATABASE_URL="postgresql://user:password@host.render.com:5432/ig_autoreply"
# Local dev without Render: run a local Postgres, or temporarily switch
# prisma/schema.prisma provider back to "sqlite" and use file:./dev.db

# --- NextAuth ---
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Instagram / Meta Graph API ---
# Create an app at https://developers.facebook.com, add "Instagram Graph API"
# product, and get these from your app + connected Instagram Business account.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="choose-any-string-and-reuse-it-in-meta-dashboard"

# --- Billing (Razorpay recommended for INR/₹ subscriptions) ---
# Wire these up in lib/subscription.ts + app/api/billing/* once ready to charge.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
